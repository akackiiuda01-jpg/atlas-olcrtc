[Unit]
Description=Atlas VK Bot
After=network-online.target atlasd.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/atlas-vk-bot
ExecStart=/opt/atlas-vk-bot/venv/bin/python3 /opt/atlas-vk-bot/bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
